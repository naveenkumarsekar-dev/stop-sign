# Copy to .env and fill in.
STOPSIGN_ADMIN_TOKEN=change-me-to-a-long-random-string
STOPSIGN_MODE=rotate            # legal | harm | scope | combined | rotate | off
STOPSIGN_TRUST_PROXY=true       # true behind a reverse proxy / for local evals
STOPSIGN_HONEYTOKEN=ak_live_7f3c91d2e8b04a6f9c55e1aa   # rotate per deployment
LLM_PROVIDER=anthropic          # anthropic | openai
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=              # any OpenAI-compatible endpoint (Groq, Together, local Ollama...)
